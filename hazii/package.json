{
  "name": "sino",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:dev": "node --watch api/server.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test src/features/study/*.test.js src/features/profile/*.test.js api/*.test.mjs",
    "test:personal": "node --test api/personalCards.test.mjs",
    "preview": "vite preview",
    "temporary:start": "node scripts/temporaryAccess.mjs start",
    "temporary:status": "node scripts/temporaryAccess.mjs status",
    "temporary:stop": "node scripts/temporaryAccess.mjs stop",
    "db:migrate:catalog": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U hazii_app -d hazii_dev -f /docker-entrypoint-initdb.d/02-catalog-schema.sql",
    "db:migrate:dictionary": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U hazii_app -d hazii_dev -f /docker-entrypoint-initdb.d/03-dictionary-schema.sql",
    "db:migrate:personal": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U hazii_app -d hazii_dev -f /docker-entrypoint-initdb.d/04-personal-cards.sql",
    "db:migrate:folders": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U hazii_app -d hazii_dev -f /docker-entrypoint-initdb.d/05-personal-folders.sql",
    "dictionary:import": "node scripts/importBkrsDictionary.mjs",
    "db:seed:hsk1": "node scripts/seedHsk1Postgres.mjs",
    "db:seed:hsk2-6": "node scripts/seedHsk2To6Postgres.mjs",
    "data:download:gushi": "node scripts/downloadGushiHskVocabulary.mjs",
    "data:extract:russian-hsk2-6": "python scripts/extractRussianHskPdfCatalogs.py",
    "data:build:hsk2-6": "node scripts/buildHsk2To6Catalogs.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "express": "^5.2.1",
    "hanzi-writer": "^3.5.0",
    "hanzi-writer-data": "^2.0.1",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
